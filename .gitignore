# OS
.DS_Store

# Python
venv/
__pycache__/
*.pyc

# Zip files
*.zip

# Log files
*.log

# MkDocs build output
site/

# Generated at build time by skills_catalog.py hook
docs/javascripts/skills-data.json
docs/skills/*.md
!docs/skills/index.md
# Generated at build time by agents_catalog.py hook
docs/javascripts/agents-data.json
docs/custom-agents/*.md
!docs/custom-agents/index.md
# Generated at build time by mcp_catalog.py hook
docs/javascripts/mcp-data.json
docs/mcp-servers/*.md
!docs/mcp-servers/index.md

# Claude
.claude/*
!.claude/CLAUDE.md

# Agent task notes and review write-ups. These are working notes for a single
# change, and they quote whatever the agent was looking at — including real AWS
# account IDs in prose, which the AWS identifier scan cannot prove and so cannot
# catch. Keeping the directory out of git is the enforcement the note's own
# "do not commit" header is not.
.agents/

# Git worktrees. An agent working on a branch in parallel with the checkout
# creates one here, and each is a full second copy of the tree, so committing one
# would nest the repository inside itself. Git keeps the worktree's own
# administrative files elsewhere, under .git/worktrees, so ignoring this
# directory loses nothing.
.worktrees/

# Holmes
.holmesignore
