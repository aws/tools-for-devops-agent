{
  "_comment": "Least-privilege execution-role policy for the iam-drift-diff MCP Lambda. READ-ONLY against IAM; read/write only on the server's own private snapshot bucket; KMS use only on the snapshot CMK. No iam:* write/mutating action appears here by design. Replace ACCOUNT_ID, SNAPSHOT_BUCKET, and KMS_KEY_ARN at deploy time (the SAM template wires these automatically).",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IamReadOnlyForDrift",
      "Effect": "Allow",
      "Action": [
        "iam:GetAccountAuthorizationDetails"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SnapshotBucketObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::SNAPSHOT_BUCKET",
        "arn:aws:s3:::SNAPSHOT_BUCKET/snapshots/*"
      ]
    },
    {
      "Sid": "SnapshotEncryptionKeyOnly",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "KMS_KEY_ARN"
    },
    {
      "Sid": "AccountGuard",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
