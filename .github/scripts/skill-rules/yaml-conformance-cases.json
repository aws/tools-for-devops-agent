{
  "description": "Conformance cases for the YAML in connectors/<name>/connector.yaml and connectors/releases.yaml. Other YAML parsers read some YAML differently from PyYAML, or refuse it, so these files may hold only YAML that every parser reads the same way. Each case is a whole file and gives its expect result: pass means the YAML is read without a problem, fail means it is refused, and error is a fragment of this repository's own message. Another tool that reads these files should give the same result on every case. The SKILL.md frontmatter follows the same rules and stricter ones (see conformance-cases.json), so a pass case here can fail as frontmatter, and a frontmatter never ends in a line break, since the closing --- line holds it. tests/test_skill_checks.py runs every case.",
  "cases": [
    {
      "id": "plain strings",
      "yaml": "name: cribl\nversion: 1.0.0\ntitle: yes please\nteam: on-call\nurl: https://example.com/a?b=c\n",
      "expect": "pass"
    },
    {
      "id": "quoted values that a parser would type if plain",
      "yaml": "a: \"1.0\"\nb: 'yes'\nc: \"2026-11-08\"\nd: \"~\"\ne: \"<<\"\nf: \"0x1F\"\n",
      "expect": "pass"
    },
    {
      "id": "canonical ints",
      "yaml": "a: 0\nb: 3\nc: -3\nd: 9007199254740991\ne: -9007199254740991\n",
      "expect": "pass"
    },
    {
      "id": "decimals that round-trip",
      "yaml": "a: 1.5\nb: -0.25\nc: 0.0001\n",
      "expect": "pass"
    },
    {
      "id": "true, false and null",
      "yaml": "a: true\nb: false\nc: null\nd: ~\ne:\n",
      "expect": "pass"
    },
    {
      "id": "quoted keys",
      "yaml": "'true': a\n\"1\": b\n'null': c\n\"1.0\": d\n'~': e\n",
      "expect": "pass"
    },
    {
      "id": "flow collections",
      "yaml": "a: [x, 1, {b: true}]\n",
      "expect": "pass"
    },
    {
      "id": "block scalars",
      "yaml": "a: |\n  yes\nb: >\n  1.0\n",
      "expect": "pass"
    },
    {
      "id": "CRLF line ends",
      "yaml": "a: 1\r\nb: x\r\n",
      "expect": "pass"
    },
    {
      "id": "a document start marker",
      "yaml": "---\na: 1\n",
      "expect": "pass"
    },
    {
      "id": "tag !!str on a value",
      "yaml": "a: !!str 1\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag !!map on a collection",
      "yaml": "a: !!map {b: 1}\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag on a key",
      "yaml": "!!str k: v\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag on an explicit key",
      "yaml": "? !!str k\n: v\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag on a key in a flow map",
      "yaml": "{!!str k: v}\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "non-specific tag !",
      "yaml": "a: ! x\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "custom tag",
      "yaml": "a: !custom x\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag on an empty node",
      "yaml": "a: !!null\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag on the root collection",
      "yaml": "!!map\nk: v\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag on a sequence item",
      "yaml": "- !!str x\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag on a block scalar",
      "yaml": "a: !!str |\n  x\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "tag in a flow sequence",
      "yaml": "a: [!!str x]\n",
      "expect": "fail",
      "error": "uses tags"
    },
    {
      "id": "merge key with an alias",
      "yaml": "base: &b {x: 1}\nchild:\n  <<: *b\n",
      "expect": "fail",
      "error": "uses anchors"
    },
    {
      "id": "merge key without an alias",
      "yaml": "child:\n  <<: {x: 1}\n",
      "expect": "fail",
      "error": "<< key"
    },
    {
      "id": "single-quoted merge key",
      "yaml": "'<<': {x: 1}\n",
      "expect": "fail",
      "error": "<< key"
    },
    {
      "id": "double-quoted merge key",
      "yaml": "\"<<\": {x: 1}\n",
      "expect": "fail",
      "error": "<< key"
    },
    {
      "id": "merge key in a flow map",
      "yaml": "{<<: {x: 1}}\n",
      "expect": "fail",
      "error": "<< key"
    },
    {
      "id": "explicit merge key",
      "yaml": "? <<\n: {x: 1}\n",
      "expect": "fail",
      "error": "<< key"
    },
    {
      "id": "byte order mark at the start",
