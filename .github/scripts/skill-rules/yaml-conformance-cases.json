      "expect": "fail",
      "error": "byte order mark"
    },
    {
      "id": "byte order mark in a plain value",
      "yaml": "a: x\ufeffy\n",
      "expect": "fail",
      "error": "byte order mark"
    },
    {
      "id": "byte order mark in a quoted value",
      "yaml": "a: \"x\ufeff\"\n",
      "expect": "fail",
      "error": "byte order mark"
    },
    {
      "id": "byte order mark in a comment",
      "yaml": "# c\ufeff\na: 1\n",
      "expect": "fail",
      "error": "byte order mark"
    },
