      "expect": "pass"
    },
    {
      "id": "block scalar that ends in a line of spaces with no line break",
      "yaml": "a: |\n  ",
      "expect": "fail",
      "error": "no line break after it"
    },
    {
      "id": "keep block scalar that ends in a line of spaces as indented as its content",
      "yaml": "a: |+\n  x\n  ",
      "expect": "fail",
      "error": "no line break after it"
    },
    {
      "id": "block scalar that ends in a line of spaces as indented as its content",
      "yaml": "a: |\n  x\n  ",
      "expect": "pass"
    },
    {
      "id": "lone - key with no value in a flow map",
      "yaml": "k: {-}\n",
      "expect": "fail",
      "error": "unquoted entry in a flow collection"
    },
    {
      "id": "lone - value in a flow sequence",
      "yaml": "k: [a, -]\n",
      "expect": "fail",
      "error": "unquoted entry in a flow collection"
    },
    {
      "id": "lone - key before a colon in a flow map",
      "yaml": "k: {-: v}\n",
      "expect": "pass"
    },
    {
      "id": "comment right after a double-quoted value",
      "yaml": "k: \"a\"#c\n",
      "expect": "fail",
