{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReviewBeforeApplyingDenyBedrockToIamUsers",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:CallWithBearerToken",
        "bedrock-mantle:CallWithBearerToken"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalType": [
            "User",
            "Account"
          ]
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::<account-id>:user/<exception-user-name>"
          ]
        }
      }
    }
  ]
}
