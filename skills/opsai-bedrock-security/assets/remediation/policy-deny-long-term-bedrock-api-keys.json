{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReviewBeforeApplyingDenyUsingLongTermBedrockApiKeys",
      "Effect": "Deny",
      "Action": "bedrock:CallWithBearerToken",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "bedrock:BearerTokenType": "LONG_TERM"
        }
      }
    },
    {
      "Sid": "ReviewBeforeApplyingDenyUsingLongTermBedrockMantleApiKeys",
      "Effect": "Deny",
      "Action": "bedrock-mantle:CallWithBearerToken",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "bedrock-mantle:BearerTokenType": "LONG_TERM"
        }
      }
    },
    {
      "Sid": "ReviewBeforeApplyingDenyCreatingBedrockApiKeys",
      "Effect": "Deny",
      "Action": "iam:CreateServiceSpecificCredential",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:ServiceSpecificCredentialServiceName": "bedrock.amazonaws.com"
        }
      }
    }
  ]
}
