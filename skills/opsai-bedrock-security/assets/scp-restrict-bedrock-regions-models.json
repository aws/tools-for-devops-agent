{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReviewBeforeApplyingDenyBedrockOutsideApprovedRegions",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream",
        "bedrock:CallWithBearerToken",
        "bedrock-mantle:CallWithBearerToken"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "<approved-region>"
          ]
        }
      }
    },
    {
      "Sid": "ReviewBeforeApplyingDenyUnapprovedBedrockModels",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream"
      ],
      "NotResource": [
        "arn:aws:bedrock:*::foundation-model/<approved-model-id>",
        "arn:aws:bedrock:*:*:inference-profile/*.<approved-model-id>"
      ]
    }
  ]
}
