{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReviewBeforeApplyingDenyUsingBedrockApiKeys",
      "Effect": "Deny",
      "Action": [
        "bedrock:CallWithBearerToken",
        "bedrock-mantle:CallWithBearerToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReviewBeforeApplyingDenyCreatingBedrockApiKeys",
      "Effect": "Deny",
      "Action": "iam:CreateServiceSpecificCredential",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:ServiceSpecificCredentialServiceName": "bedrock.amazonaws.com"
        }
      }
    }
  ]
}
