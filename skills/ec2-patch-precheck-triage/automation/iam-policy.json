{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SsmRunCommandForPrecheckRemediation",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SsmPatchStateAndOpsItemTriage",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstancePatchStates",
        "ssm:DescribeInstancePatches",
        "ssm:GetOpsItem",
        "ssm:UpdateOpsItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ControlPlaneChecksForUnreachableInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "iam:ListAttachedRolePolicies",
        "iam:GetInstanceProfile"
      ],
      "Resource": "*"
    }
  ]
}
