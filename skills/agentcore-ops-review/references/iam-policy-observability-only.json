{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentCoreObservabilityOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "health:DescribeEvents",
        "health:DescribeEventDetails",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostExplorerAccountLevel",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetDimensionValues"
      ],
      "Resource": "*"
    }
  ]
}
