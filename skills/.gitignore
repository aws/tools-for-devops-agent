# Only allow file extensions supported by AWS DevOps Agent skill uploads
# Ignore all files by default
*

# Allow directories (needed for recursion)
!*/

# Allow .gitignore itself
!.gitignore

# Allowed extensions
!*.md
!*.txt
!*.json
!*.yaml
!*.yml
!*.xml
!*.csv
!*.tsv
!*.html
!*.htm
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.webp
!*.pdf

# Re-ignore disallowed directories (must come after allowlist)
**/scripts/
**/.claude/

# Debug traces written by the skill evaluation tool and its SDK. Useful locally
# while iterating on a skill, but not part of the skill or its eval results.
**/cli_debug/
**/sdk_debug/

# Intermediate per-iteration output from functional tests. outputs/journal_records.json
# is deliberately NOT ignored — it holds the DevOps Agent journal for the run and is
# the evidence of what the evaluation actually produced. Patterns are scoped to
# outputs/ so these common filenames stay committable elsewhere under skills/.
**/outputs/classified_output.json
**/outputs/metadata.json

# Functional-run metadata written by the skill evaluation tool. Contains
# environment-specific, account-linked data (CloudFormation stack ARNs bearing the
# eval AWS account ID, agent-space IDs, local filesystem paths). Not required by
# validate-skill-evals.yml, so it is not committed.
**/functional/**/_metadata.json
