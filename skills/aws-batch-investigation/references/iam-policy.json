{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BatchSilentFailureDetection",
      "Effect": "Allow",
      "Action": [
        "batch:ListJobs",
        "batch:DescribeJobQueues"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION"
        }
      }
    },
    {
      "Sid": "BatchCapacityAndJobConfigInvestigation",
      "Effect": "Allow",
      "Action": [
        "batch:DescribeComputeEnvironments",
        "batch:DescribeJobs",
        "batch:DescribeSchedulingPolicies",
        "autoscaling:DescribeAutoScalingGroups",
        "autoscaling:DescribeScalingActivities"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION"
        }
      }
    }
  ]
}
