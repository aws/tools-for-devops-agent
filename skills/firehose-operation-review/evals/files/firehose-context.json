{
  "deliveryStreams": [
    {
      "name": "orders-ingest-stream",
      "sourceType": "DirectPut",
      "destination": "ExtendedS3",
      "region": "us-east-1",
      "account": "$accountId",
      "compressionFormat": "UNCOMPRESSED",
      "encryption": "AWS_OWNED_CMK",
      "s3BackupMode": "Disabled",
      "cloudWatchLoggingEnabled": false,
      "deliveryStreamStatus": "ACTIVE"
    },
    {
      "name": "events-to-opensearch",
      "sourceType": "KinesisStreamAsSource",
      "destination": "AmazonOpenSearchService",
      "region": "us-east-1",
      "account": "$accountId",
      "compressionFormat": "GZIP",
      "encryption": "CUSTOMER_MANAGED_CMK",
      "s3BackupMode": "FailedDataOnly",
      "cloudWatchLoggingEnabled": true,
      "deliveryStreamStatus": "ACTIVE"
    }
  ]
}
