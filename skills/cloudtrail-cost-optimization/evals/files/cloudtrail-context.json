{
  "account": "$accountId",
  "trails": [
    {
      "name": "org-multi-region-trail",
      "isMultiRegionTrail": true,
      "isOrganizationTrail": true,
      "isLogging": true,
      "managementEvents": true,
      "managementEventReadWriteType": "All",
      "dataEvents": false,
      "region": "us-east-1",
      "s3Bucket": "org-cloudtrail-logs"
    },
    {
      "name": "legacy-security-trail",
      "isMultiRegionTrail": false,
      "isOrganizationTrail": false,
      "isLogging": true,
      "managementEvents": true,
      "managementEventReadWriteType": "All",
      "dataEvents": false,
      "region": "us-east-1",
      "s3Bucket": "legacy-security-logs"
    },
    {
      "name": "s3-data-events-all-buckets",
      "isMultiRegionTrail": false,
      "isOrganizationTrail": false,
      "isLogging": true,
      "managementEvents": false,
      "dataEvents": true,
      "dataEventScope": "all S3 buckets",
      "region": "us-west-2",
      "s3Bucket": "data-event-logs"
    }
  ],
  "eventDataStores": [
    {
      "name": "audit-lake-store",
      "retentionDays": 2555,
      "pricingOption": "FIXED_RETENTION_PRICING",
      "multiRegion": true
    }
  ]
}
